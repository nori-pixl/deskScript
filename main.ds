myprocess:main.ds

// ==========================================
// 1. グローバル設定（全行・全デスク共通の保管庫）
// ==========================================
set:var(string, global/all/envType) = "PRODUCTION"
set:var(string, global/all/systemName) = "DeskScript-Core"


// ==========================================
// 2. 共通関数（引数は10個でもいくらでも並べられる）
// ==========================================
function:buildReport(string title, int code, string status){
   "[", global.systemName, "] ", title, " (コード:", code, " / 状態:", status, ")"
}


// ==========================================
// 3. メインロジック（デスクと引き出し）
// ==========================================
desk:ultimateDesk(string inputData){
   drawer:allInOneDrawer(action99){
      // 引数で渡されたデータを、この引き出し専用（hostスコープ）にコピー
      host.var.string:targetToken(id, inputData)
      
      inreturn:resultReturn{
         // --- ① 共通関数の呼び出し ---
         buildReport("システム監査ログ", 404, "警告検知"), "\n\n"

         // --- ② 四則演算の評価 ---
         "[数式計算] 10 + 20 * 3 = ", 10 + 20 * 3, "\n"
         "[余り計算] 10 % 3 = ", 10 % 3, "\n\n"

         // --- ③ 外部ライブラリ（import.ds.txt）のドット関数呼び出し ---
         // cryptoライブラリを使ってハッシュ値をダイレクト生成
         "  -> 暗号化ハッシュ（SHA256）: ", crypto.createHash("sha256").update(targetToken).digest("hex"), "\n\n"

         // --- ④ if / elif / else 構文（bool型スイッチ埋め込み） ---
         "[条件分岐判定]\n"
         if(global.envType == "PRODUCTION"):true {
            "  -> [判定結果] 本番環境（PRODUCTION）が有効です。\n"
         }
         elif(global.envType == "DEVELOP"):true {
            "  -> [判定結果] 開発環境が有効です。\n"
         }
         else {
            "  -> [判定結果] 不明な環境です。\n"
         }
         "\n"

         // --- ⑤ switch 構文 ---
         "[switch割り振り]\n"
         switch(targetToken):case("CriticalError"){
            "  └─> 緊急警戒引き出しへ転送します。\n"
         }
         case("NormalLog"){
            "  └─> 通常ストレージへ自動格納します。\n"
         }
         default{
            "  └─> 汎用タスクとして処理します。\n"
         }
         "\n"

         // --- ⑥ while 構文（擬似条件ループ） ---
         "[whileテスト]\n"
         while(1 < 2):true {
            "  -> whileの条件が一致している間、処理を回します。\n"
         }
         "\n"

         // --- ⑦ for 構文（dis.var使い捨て変数 ＆ end安全着地点） ---
         "[forループ実行]\n"
         // 1から始まって「++（1ずつ増加）」し、「3回」繰り返す
         for(dis.var:step in ++1):3 {
            "  -> [周回] 現在のステップ数: ", step, "\n"
         }
         end {
            // ループを抜けた瞬間に、使い捨て変数「step」はメモリから完全に消滅（Discard）します
            "  -> [安全確認] ループ終了。使い捨て変数はシュレッダーにかけられました。\n\n"
         }

         // --- ⑧ try - catch - end 構文（エラーハンドリング） ---
         "[try-catch例外テスト]\n"
         try {
            "  -> 正常なタスクプロセスを実行中...\n"
         }
         catch(dis.var:errorMessage) {
            "  [!] エラーを安全に捕獲しました。理由: ", errorMessage, "\n"
         }
         end {
            "  -> [try完了] エラーの有無に関わらず、デスクの安全は保護されました。\n\n"
         }

         // --- ⑨ forever 構文（一番シンプルな永久監視） ---
         forever(true){
            "  [常時監視] バックグラウンドプロセスが安定稼働しています。\n"
         }
      }
   }
   outreturn{
      resultReturn
   }
}


// ==========================================
// 4. デスクの呼び出し（run）
// ==========================================
// run(desk名(引数)) の形で、いくらでも並べて書くことができる。
// それぞれの outreturn の結果が順番に実行・出力される。
run(ultimateDesk("勇者アレン"))
run(ultimateDesk("量産型ボット"))


// ==========================================
// 5. Worker機能（deskを扱う働き者の管理）
// ==========================================
// workerを登録（名前とパスワード）
set:worker("tanaka", "pass1234")

// workerを雇用する（hireするまではそのworkerが担当するdeskをrunできない）
hire("tanaka")

// @worker(...) を直前に書くと、そのdeskの担当者を指定できる。
// 担当者を指定したdeskは、run(desk名(引数)) では呼べず、
// run("desk名","worker名","パスワード") で認証つきで呼び出す必要がある。
@worker("tanaka", "pass1234")
desk:workerDemoDesk(string inputData){
   drawer:workerDrawer(action01){
      host.var.string:targetToken(id, inputData)
      inreturn:resultReturn{
         "[担当者専用デスク] tanakaさんが「", targetToken, "」を処理しました。\n"
      }
   }
   outreturn{
      resultReturn
   }
}

// worker認証つきで呼び出す（tanakaは雇用中なので成功する）
run("workerDemoDesk", "tanaka", "pass1234")

// workerを解雇する（本人のパスワードと一致しないと解雇できない）
// 解雇するとdeskを扱う人がいなくなるので、以降そのworkerではrunできなくなる。
// 再度 hire("tanaka") すれば、また雇用状態に戻せる。
dism("tanaka", "pass1234")
run("workerDemoDesk", "tanaka", "pass1234")   // ← 解雇後なのでエラーになる


// ==========================================
// 6. ログ出力（command.log.print）
// ==========================================
// "文字列", 変数名, 関数名(), desk名(引数) を好きな数・好きな順番で並べて出力できる。
// hire/dism/runと同じく「書かれた順番」で実行される（runの間に挟んでデバッグ出力にも使える）。
command.log.print("[システム情報] ", systemName, " / 環境: ", envType)
command.log.print("レポート -> ", buildReport("起動チェック", 200, "正常"))
command.log.print("desk直接呼び出し -> ", ultimateDesk("ログテスト用"))
